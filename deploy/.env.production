# ═══════════════════════════════════════════════════
#  متغیرهای محیطی — بک‌اند باشگاه مشتریان پویا
#  کپی کنید به: /opt/pouya-crm/backend/.env
# ═══════════════════════════════════════════════════

NODE_ENV=production
PORT=5000

# --- دیتابیس PostgreSQL ---
DATABASE_URL="postgresql://loyalty_user:YOUR_DB_PASSWORD@localhost:5432/pouya_loyalty?schema=public"

# --- JWT ---
JWT_SECRET="YOUR_JWT_SECRET_MIN_32_CHARS_CHANGE_THIS"
OTP_SECRET="USE_A_DIFFERENT_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# --- فرانت‌اند (CORS) ---
FRONTEND_URL="https://club.pouyaplastic.ir"

# --- هپی‌کال (پیامک) ---
HEPIKAL_API_KEY=""
HEPIKAL_SENDER_NUMBER=""
HEPIKAL_API_URL="https://api.happykal.com/v1"
HEPIKAL_DRY_RUN="true"

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@pouyaplastic.ir"

# --- سپیدار ---
SEPIDAR_API_URL=""
SEPIDAR_API_KEY=""
SEPIDAR_API_SECRET=""
